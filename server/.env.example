# ====== Servidor do App de EPI ======
# Copie este arquivo para ".env" e ajuste os valores.

# Porta HTTP do servidor
PORT=3000

# OBRIGATÓRIO: Senha do usuário administrador.
ADMIN_PASSWORD=

# Domínio permitido para CORS (ex: https://seudominio.com)
ALLOWED_ORIGIN=http://localhost:3000

# Período de validade do token em minutos
TOKEN_TTL_MIN=720

# Backup automático (JSON em server/data/backups/)
BACKUP_INTERVAL_MIN=1440
BACKUP_RETENTION=10
